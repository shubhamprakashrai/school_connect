# Database Configuration Environment Variables
# Copy this file to .env and update with your actual values
# These variables override the default values in application.properties

# PostgreSQL Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/school_mgmt_db
SPRING_DATASOURCE_USERNAME=school_admin
SPRING_DATASOURCE_PASSWORD=school_password

# Redis Cache (optional - defaults to localhost:6379)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Spring Profile (optional - defaults to dev)
SPRING_PROFILES_ACTIVE=dev
